SC

(* Define co (and fr) *)
include "cos.cat"

(* All communication relations *)
let com = (rf | fr | co)

(* Sequential consistency *)
acyclic po | com as sc

(* Atomicity *)
empty rmw & (fre;coe)



(* Use after free detection *)
let hb = po | com
let hb_after_free = [MFR];hb+;[M]
let use_after_free = hb_after_free & sobj
flag ~empty (use_after_free)